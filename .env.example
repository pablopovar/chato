# HTTP/API
NERDO_PORT=
NERDO_ROOT_PATH=/api
NERDO_PUBLIC_ORIGINS=https://nerdo.povarchik.com,https://povarchik.com
NERDO_ADMIN_TOKEN=replace-with-a-long-random-token
NERDO_PUBLIC_BASE_URL=https://nerdo.povarchik.com

# Intake and crawler: deliberately slow, randomized, and bounded.
NERDO_CRAWL_MAX_PAGES=24
NERDO_CRAWL_MAX_ATTEMPTS=60
NERDO_CRAWL_MAX_DEPTH=4
NERDO_CRAWL_MAX_LINKS_PER_PAGE=120
NERDO_CRAWL_MIN_DELAY_SECONDS=2.5
NERDO_CRAWL_MAX_DELAY_SECONDS=6.5
NERDO_CRAWL_MAX_DURATION_SECONDS=900
NERDO_CRAWL_TIMEOUT_SECONDS=25
NERDO_CRAWL_MAX_PAGE_BYTES=2000000
NERDO_CRAWL_MAX_TOTAL_BYTES=24000000
NERDO_CRAWL_MAX_REDIRECTS=6
NERDO_CRAWL_ALLOW_SUBDOMAINS=false
NERDO_CRAWL_USER_AGENT=Nerdo/0.2 (+https://nerdo.povarchik.com/)

# Cleaning and indexing
NERDO_CLEAN_MIN_DOCUMENT_CHARS=120
NERDO_CLEAN_NEAR_DUPLICATE_THRESHOLD=0.92
NERDO_INDEX_CHUNK_CHARS=1800
NERDO_INDEX_CHUNK_OVERLAP=180

# Workflow
NERDO_MAX_CLARIFICATION_EMAILS=3
NERDO_WORKER_POLL_SECONDS=3

# OpenAI-compatible model endpoint (interpretation/chat bridge)
NERDO_MODEL_BASE_URL=http://host.docker.internal:11434/v1
NERDO_MODEL_API_KEY=ollama
NERDO_MODEL_NAME=qwen3.5:latest
NERDO_MODEL_TIMEOUT_SECONDS=600
NERDO_MODEL_MAX_TOKENS=1200

# SMTP transport bridge
NERDO_SMTP_HOST=hq3-mx-10
NERDO_SMTP_PORT=25
NERDO_SMTP_TLS_MODE=none
NERDO_SMTP_USERNAME=
NERDO_SMTP_PASSWORD=
NERDO_SMTP_FROM_EMAIL=
NERDO_SMTP_FROM_NAME=Chato & Nerdo
NERDO_OPERATOR_TOKEN=replace-with-a-separate-operator-token

# Pablo CLI: OAuth 2.0 Client Credentials
NERDO_OAUTH_CLIENT_ID=
NERDO_OAUTH_CLIENT_SECRET=replace-with-a-long-random-client-secret
NERDO_OAUTH_TOKEN_SIGNING_KEY=replace-with-a-different-long-random-signing-key
NERDO_OAUTH_SCOPE=sites:start
NERDO_OAUTH_ACCESS_TOKEN_TTL_SECONDS=900

NERDO_SMTP_REPLY_TO=
NERDO_INTRO_EMAIL_SUBJECT=

# Local CLI default. Override when running elsewhere.
NERDO_API_BASE_URL=http://127.0.0.1:3400
NERDO_MAIL_POLL_SECONDS=10
NERDO_MAIL_STABLE_SECONDS=2
NERDO_MAIL_ATTACH_MAX_BYTES=20000000
NERDO_ADMIN_EMAILS=pablo@povarchik.com
NERDO_HOST_GID=1000
